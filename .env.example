# Environment Variables Example
# Copy this file to .env and fill in the actual values
# Vite requires client-side variables to be prefixed with VITE_

# Main API Service (taxonomy, institutions, records) - Port 8000
VITE_API_BASE_URL=http://localhost:8000/api

# Auth Center - Port 8010
VITE_AUTH_CENTER_URL=http://localhost:8010

# FishesOfLA API - Port 8001
VITE_FISHESOFLA_API_URL=http://localhost:8001

# FishAIR API - Port 8010
VITE_FISHAIR_API_URL=http://localhost:8010/api

# Image Server - Port 8003
VITE_IMAGE_SERVER_URL=http://127.0.0.1:8003

# Elasticsearch - Port 9200
VITE_ELASTICSEARCH_URL=http://localhost:9200

# TUMMT Data Management System - Port 9528
VITE_TUMMT_URL=http://localhost:9528

# Project Code
VITE_PROJECT_CODE=FN2

# API Timeout (milliseconds)
VITE_API_TIMEOUT=30000
